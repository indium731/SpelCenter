<Application x:Class="Labb1_OOP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Labb1_OOP"
             xmlns:views="clr-namespace:Labb1_OOP.Vyer"
             xmlns:vm="clr-namespace:Labb1_OOP.VyModeller">
    <Application.Resources>
