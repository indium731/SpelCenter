            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AnmalVyVM}">
                <views:AnmalVy />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MedlemVyVM}">
                <views:MedlemVy />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BokningVyVM}">
                <views:BokningVy />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BokaSpelVyVM}">
                <views:BokaSpelVy />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AndraBokningVyVM}">
