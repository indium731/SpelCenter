

<UserControl x:Class="Labb1_OOP.SpelVy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                Text="SpelCenter" />
        
        <StackPanel Grid.Row="0" Grid.Column="0">

            <ListBox x:Name="SpelListaLada"
                SelectionChanged="AndraValdSpel"/>
            
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <Button Content="Återvänd till meny" 
                Click="GaTillMeny"/>
            
            <TextBlock Text="Lägg till spel" />

            <TextBlock Text="Namn" />
            <TextBox x:Name="NamnTextLada" />

            <TextBlock Text="Kategori" />
            <TextBox x:Name="KategoriTextLada" />

            <TextBlock Text="Minimum antal spelare" />
            <TextBox x:Name="MinSpelareTextLada" />

            <TextBlock Text="Maximum antal spelare" />
            <TextBox x:Name="MaxSpelareTextLada" />

            <TextBlock Text="SvårighetsGrad"/>
            <ComboBox x:Name="SvarighetsgradLada"/>

            <TextBlock Text="Beskrivning"/>
            <TextBox x:Name="BeskrivningTextLada" />

            <Button Content="Lägg till Spel" 
                Click="TestaLaggTillSpelKlick"/>

            <Button Content="Ta bort vald spel" 
                Click="TaBortValdSpelKlick"/>

            <Button Content="Uppdatera vald spel" 
                Click="UppdateraValdSpelKlick"/>

            <TextBlock Text="Sortering"
                x:Name="SorteringTextLada"/>

            <Button Content="Ändra sortering"
                Click="AndraSorteringKlick"/>

            <TextBox x:Name="SokTextLada"/>
            <ComboBox x:Name="SokComboLada"/>
            <Button Content="Sök"
                Click="SokKlick"/>

            <TextBlock Text="Detaljer" />
            <TextBlock x:Name="DetaljTextLada" Text="Ingen medlem vald." />

        </StackPanel>
    </Grid>
</UserControl>