<UserControl x:Class="Labb1_OOP.BokningVy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                Text="SpelCenter" />
        
        <StackPanel Grid.Row="0" Grid.Column="0">

            <ListBox x:Name="SchemaTiderLada"/>

            <TextBlock Text="Datum"
                x:Name="DatumTextLada"/>
            
            <Button Content="Nästa dag"
                Click="NastaDagKlick"/>
            
            <Button Content="Föregående dag"
                Click="ForegaendeDagKlick"/>
            
            <Button Content="Nästa Vecka"
                Click="NastaVeckaKlick"/>

            <Button Content="Föregående Vecka"
                Click="ForegaendeVeckaKlick"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <Button Content="Återvänd till meny" 
                Click="GaTillMeny"/>
            
            <TextBlock Text="plats" />
            <TextBox x:Name="PlatsTextLada" />

            <TextBlock Text="maxantal" />
            <TextBox x:Name="MaxAntalTextLada" />

            <TextBlock Text="beskrivning" />
            <TextBox x:Name="BeskrivningTextLada" />

            <TextBlock Text="StartDatum" 
                x:Name="StartDatumTextLada" />

        </StackPanel>
    </Grid>
</UserControl>