<UserControl x:Class="Labb1_OOP.Vyer.MedlemMenyVy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb1_OOP.Vyer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                Text="SpelCenter" />
        
        <StackPanel Grid.Row="0" Grid.Column="0">

            <Button Content="BokningHanterare"
                x:Name="BokningHanterare"
                Click="GaTillValdVy">
                <Button.Tag>
                    <local:BokningVy/>
                </Button.Tag>
            </Button>

            <Button Content="Anmäl dig"
                x:Name="AnmalHanterare"
                Click="GaTillValdVy">
                <Button.Tag>
                    <local:AnmalVy/>
                </Button.Tag>
            </Button>
            
            <Button Content="Mina bokningar"
                x:Name="MinaBokningar"
                Visibility="Collapsed"
                Click="GaTillValdVy">
                <Button.Tag>
                    <local:MinaBokningarVy/>
                </Button.Tag>
            </Button>
            
            <Button Content="SpelHanterare"
                x:Name="SpelHanterare"
                Click="GaTillValdVy">
                <Button.Tag>
                    <local:SpelVy/>
                </Button.Tag>
            </Button>

            <Button Content="MedlemHanterare"
                x:Name="MedlemHanterare"
                Click="GaTillValdVy">
                <Button.Tag>
                    <local:MedlemVy/>
                </Button.Tag>
            </Button>


        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <Button Content="Logga ut" 
                Click="TestaUtloggKlick"/>

        </StackPanel>
    </Grid>
</UserControl>