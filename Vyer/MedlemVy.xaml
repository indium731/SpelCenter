
<UserControl x:Class="Labb1_OOP.Vyer.MedlemVy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Labb1_OOP.VyModeller"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <vm:MedlemVyVM x:Key="MedlemVyVM"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                Text="SpelCenter" />
        
        <StackPanel Grid.Row="0" Grid.Column="0">

            <ListBox ItemsSource="{Binding medlemListaLada}"
                SelectedItem="{Binding valdMedlem, Mode=TwoWay}"/>
            
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <Button Content="Återvänd till meny" 
                Command="{Binding GaTillMeny}"/>
            
            <TextBlock Text="Lägg till medlem" />

            <TextBlock Text="Namn" />
            <TextBox Text="{Binding namn}"/>

            <TextBlock Text="TelefonNummer" />
            <TextBox Text="{Binding telefonNummer}"/>

            <TextBlock Text="MedlemsNummer" />
            <TextBox Text="{Binding medlemsNummer}" />

            <CheckBox IsChecked="{Binding administrator}"
                    Content="Administratör?" />

            <Button Content="Lägg till medlem" 
                Command="{Binding TestaLaggTillMedlemKlick}"/>

            <Button Content="Ta bort vald medlem" 
                Command="{Binding TaBortValdMedlemKlick}"/>

            <Button Content="Uppdatera vald medlem" 
                Command="{Binding UppdateraValdMedlemKlick}"/>
            
            <Button Content="Öka medlemskapet med ett år"
                Command="{Binding OkaMedlemSkapAr}"/>

            <TextBlock Text="{Binding SorteringText}"/>

            <Button Content="Ändra sortering"
                Command="{Binding AndraSorteringKlick}"/>

            <TextBox Text="{Binding SokText}"
                Visibility ="{Binding SokTextVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <CheckBox IsChecked="{Binding SokCheck}"
                Visibility ="{Binding SokCheckVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <DatePicker SelectedDate="{Binding SokDatum}"
                Visibility ="{Binding SokDatumVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Sök"
                Command="{Binding SokKlick}"/>

            <TextBlock Text="Detaljer" />
            <TextBlock Text="{Binding detaljText}" />

        </StackPanel>
    </Grid>
</UserControl>