


<UserControl x:Class="Labb1_OOP.Vyer.OversiktVy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                Text="SpelCenter" />
        
        <StackPanel Grid.Row="0" Grid.Column="0">

            <ListBox ItemsSource="{Binding MedlemListaLada}"
                SelectedItem="{Binding ValdMedlem, Mode=TwoWay}"
                Visibility ="{Binding MedlemListaVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ListBox ItemsSource="{Binding SpelListaLada}"
                SelectedItem="{Binding ValdSpel, Mode=TwoWay}"
                Visibility ="{Binding SpelListaVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <Button Content="Återvänd till mina bokningar" 
                Command="{Binding GaTillMinaBokningarCommand}"/>
            
            <Button Content="Ändra visad lista" 
                Command="{Binding AndraVisadListaCommand}"/>

            <TextBlock Text="Detaljer" />
            <TextBlock Text="{Binding DetaljText}" />

        </StackPanel>
    </Grid>
</UserControl>