

<UserControl x:Class="Labb1_OOP.Vyer.SpelVy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Labb1_OOP.VyModeller"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                Text="SpelCenter" />
        
        <StackPanel Grid.Row="0" Grid.Column="0">

            <ListBox ItemsSource="{Binding SpelListaLada}"
                SelectedItem="{Binding ValdSpel}"/>
            
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <Button Content="Återvänd till meny" 
                Command="{Binding GaTillMeny}"/>
            
            <TextBlock Text="Lägg till spel" />

            <TextBlock Text="Namn" />
            <TextBox Text="{Binding namn}" />

            <TextBlock Text="Kategori" />
            <TextBox Text="{Binding kategori}" />

            <TextBlock Text="Minimum antal spelare" />
            <TextBox Text="{Binding minAntal}" />

            <TextBlock Text="Maximum antal spelare" />
            <TextBox Text="{Binding maxAntal}" />

            <TextBlock Text="SvårighetsGrad"/>
            <ComboBox Text="{Binding svarighetsgrad}"/>

            <TextBlock Text="Beskrivning"/>
            <TextBox Text="{Binding beskrivning}" />

            <Button Content="Lägg till Spel" 
                Command="{Binding TestaLaggTillSpelKlick}"/>

            <Button Content="Ta bort vald spel" 
                Command="{Binding TaBortValdSpelKlick}"/>

            <Button Content="Uppdatera vald spel" 
                Command="{Binding UppdateraValdSpelKlick}"/>

            <TextBlock 
                Text="{Binding sortering}"/>

            <Button Content="Ändra sortering"
                Command="{Binding AndraSorteringKlick}"/>

            <TextBox Text="{Binding sokText}"
                Visibility ="{Binding SokDatumVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ComboBox ItemsSource="{Binding Svarighetsgrad}"
                SelectedItem="{Binding valdSvarighetsgrad}"
                Visibility ="{Binding SokDatumVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Sök"
                Command="{Binding sokKlick}"/>

            <TextBlock Text="Detaljer" />
            <TextBlock Text="{Binding detaljText}"/>

        </StackPanel>
    </Grid>
</UserControl>