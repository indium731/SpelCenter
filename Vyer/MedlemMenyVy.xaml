<UserControl x:Class="Labb1_OOP.Vyer.MedlemMenyVy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb1_OOP.Vyer"
             xmlns:vm="clr-namespace:Labb1_OOP.VyModeller"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                Text="SpelCenter" />
        
        <StackPanel Grid.Row="0" Grid.Column="0">

            <Button Content="BokningHanterare"
                x:Name="BokningHanterare"
                Command="{Binding GaTillValdVyCommand}"
                CommandParameter="{x:Type vm:BokningVyVM}" 
                Visibility ="{Binding BokningHanterareVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="Anmäl dig"
                x:Name="AnmalHanterare"
                Command="{Binding GaTillValdVyCommand}"
                CommandParameter="{x:Type vm:AnmalVyVM}" 
                Visibility ="{Binding AnmalHanterareVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            
            <Button Content="Mina bokningar"
                x:Name="MinaBokningar"
                Command="{Binding GaTillValdVyCommand}"
                CommandParameter="{x:Type vm:MinaBokningarVyVM}" 
                Visibility ="{Binding MinaBokningarVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            
            <Button Content="SpelHanterare"
                x:Name="SpelHanterare"
                Command="{Binding GaTillValdVyCommand}"
                CommandParameter="{x:Type vm:SpelVyVM}" 
                Visibility ="{Binding SpelHanterareVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="MedlemHanterare"
                x:Name="MedlemHanterare"
                Command="{Binding GaTillValdVyCommand}"
                CommandParameter="{x:Type vm:MedlemVyVM}" 
                Visibility ="{Binding MedlemHanterareVisas, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <Button Content="Logga ut" 
                Command="{Binding LoggaUtCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>