

<UserControl x:Class="Labb1_OOP.Vyer.MinaBokningarVy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Labb1_OOP.VyModeller"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                Text="SpelCenter" />
        
        <StackPanel Grid.Row="0" Grid.Column="0">

            <ListBox ItemsSource="{Binding Bokningar}"
                SelectedItem="{Binding ValdBokning, Mode=TwoWay}"/>
            
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <Button Content="Återvänd till meny" 
                Command="{Binding GaTillMenyCommand}"/>
            
            <TextBlock Text="Dina bokningar" />

            <Button Content="Få översikt" 
                Command="{Binding GaTillOversiktCommand}"/>

            <Button Content="Ändra bokning" 
                Command="{Binding GaTillAndraBokningCommand}"/>

            <Button Content="Ta bort vald bokning" 
                Command="{Binding TaBortValdBokningCommand}"/>

            <TextBlock Text="Detaljer" />
            <TextBlock Text="{Binding DetaljText}"/>

        </StackPanel>
    </Grid>
</UserControl>