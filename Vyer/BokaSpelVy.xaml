


<UserControl x:Class="Labb1_OOP.Vyer.BokaSpelVy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                Text="SpelCenter" />
        
        <StackPanel Grid.Row="0" Grid.Column="0">

            <ListBox ItemsSource="{Binding SpelListaLada}"
                SelectedItem="{Binding ValdSpel}"/>
            
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <Button Content="Återvänd till meny" 
                Command="{Binding GaTillMenyCommand}"/>
            
            <Button Content="Boka spel" 
                x:Name="BokaSpelKnapp"
                Command="{Binding TestaBokaSpelCommand}"/>

            <Button Content="Avboka vald spel" 
                Command="{Binding AvbokaValdSpelCommand}"/>

            <TextBlock Text="Detaljer" />
            <TextBlock Text="{Binding DetaljText}" />

        </StackPanel>
    </Grid>
</UserControl>